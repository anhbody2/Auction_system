{
  "name": "auction-system",
  "private": true,
  "workspaces": [
    "be",
    "fe"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run db:migrate -w be",
    "test": "npm run db:up && npm test -w be && npm run build -w fe",
    "e2e": "npm run db:up && playwright test",
    "dev": "npm run db:up && concurrently -n be,fe -c blue,green \"npm run dev -w be\" \"npm run dev -w fe\"",
    "postinstall": "npx prisma generate --schema be/prisma/schema.prisma",
    "verify": "npm test && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "concurrently": "9.1.0"
  }
}
